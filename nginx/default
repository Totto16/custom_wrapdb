# This is the web server config for <CUSTOM_DOMAIN>

server {

  set $github_host github.com;
  set $github_repo_user <GH_USER>;
  set $github_repo_name <GH_REPO>;
  set $wrap_custom_domain <CUSTOM_DOMAIN>;
  set $wrap_gh_pages_domain <GH_PAGES_URL>;

  location /v2 {
    rewrite ^.*/v2/releases.json$ https://$wrap_gh_pages_domain/wrapdb/releases.json permanent;
    rewrite ^.*/v2/([^/]+)/get_source/([^/]+)$ https://$github_host/$github_repo_user/$github_repo_name/releases/download/$1/$2 permanent;
    rewrite ^.*/v2/([^/]+)/get_patch$ https://$github_host/$github_repo_user/$github_repo_name/releases/download/$1/$1_patch.zip permanent;
    rewrite ^.*/v2/([^/]+)/([^/]+).wrap$ https://$github_host/$github_repo_user/$github_repo_name/releases/download/$1/$2.wrap permanent;
  }

  # Disable legacy v1 patch URLs.
  location ~ get_zip$ {
    return 501;
  }

  location = / {
    return 301 https://$wrap_gh_pages_domain/Wrapdb-projects.html;
  }

  # Disable legacy v1 patch URLs.
  location /v1/ {
    return 501;
  }

  # Disable legacy v1 patch URLs.
  location /v1-static/ {
    return 501;
  }

  # REPLACE WITH <CUSTOM_DOMAIN>
  server_name wrapdb.mesonbuild.com;

  listen [::]:443 ssl ipv6only=on; # managed by Certbot
  listen 443 ssl; # managed by Certbot

  # replace with yout ssl setup for <CUSTOM_DOMAIN>
  ssl_certificate /etc/letsencrypt/live/wrapdb.mesonbuild.com/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/wrapdb.mesonbuild.com/privkey.pem; # managed by Certbot
  include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
  # replace with <CUSTOM_DOMAIN>
  server_name wrapdb.mesonbuild.com;
  listen 80;
  listen [::]:80;

  # Redirect all HTTP requests to HTTPS with a 301 Moved Permanently response.
  return 301 https://$host$request_uri;
}
